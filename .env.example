# ================================
# Arasbaran News Bot
# Environment Variables
# ================================

# Telegram Bot Token
# توکن واقعی را اینجا قرار ندهید.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Telegram Channel ID or username
# مثال:
# @YourChannel
# یا:
# -1001234567890
TELEGRAM_CHANNEL_ID=YOUR_TELEGRAM_CHANNEL_ID

# Timezone
TIMEZONE=Asia/Tehran

# Maximum news from each source
MAX_ITEMS_PER_SOURCE=10

# Maximum total news per execution
MAX_TOTAL_ITEMS=30

# HTTP/RSS request timeout
REQUEST_TIMEOUT=25000

# News history file
DATA_FILE=data/news-history.json
REQUIRE_NEWS_DATE=true
NEWS_MAX_AGE_HOURS=24
MAX_HISTORY_ITEMS=5000
imageUrl
   ↓
downloadImage()
   ↓
imageBuffer
   ↓
telegram.js
